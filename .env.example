# BrowserX - Environment Variables для Docker

# Groq API Key (обов'язковий для AI функцій)
# Отримати тут: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Node Environment
NODE_ENV=production

# Display для X11 (default: :99)
DISPLAY=:99

# VNC порт (default: 5900)
VNC_PORT=5900
